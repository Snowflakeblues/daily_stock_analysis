# Configure these in Render. Never commit real values.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
ASHARE_ASSET_API_KEY=
OAUTH_SIGNING_KEY=
# Render uses persistent HTTPS ciphertext storage on the existing owner's VPS.
OAUTH_STATE_BACKEND=remote
OAUTH_STATE_API_KEY=
# Local development only: OAUTH_STATE_DIR=/private/persistent/path
